CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Console on the chip's own USB port (the one marked USB).
# The console is on the UART port; the USB port is a keyboard and MIDI key for practice sites (usbkey.c).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_MIDI_COUNT=1
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="SA3LEJ"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Fjarrnyckel"
CONFIG_TINYUSB_DESC_SERIAL_STRING="1"
# 1 ms scheduler tick: the keyer reads the contacts every millisecond.
CONFIG_FREERTOS_HZ=1000
# Phones probing for a captive portal send long request headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
# A new firmware that does not start properly is replaced by the previous one at the next restart.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Tailscale (MicroLink) keeps its large buffers in the module's extra memory (PSRAM).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
# Tailscale relay region the box starts in before it knows better: 28 = Helsinki. MicroLink keeps one relay
# connection, to its own home region, and a peer only listens on ITS home region until it has something to say
# to us, so the box must be at home where the receiver is (seen 2026-11-24: box in Frankfurt, receiver in
# Helsinki, no contact). The box moves to the receiver's region by itself, or to the one chosen on the page
# (settings.ts_region); this value only decides where the very first connection goes.
CONFIG_ML_DERP_REGION=28
# The box confirms a new firmware itself at start (update.c); MicroLink must not also restart it.
# CONFIG_ML_OTA_ROLLBACK is not set
# The peer list kept in flash has to fit the 24 KB settings area next to our own settings.
CONFIG_ML_NVS_MAX_PEERS=16
