CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Console on the chip's own USB port (the one marked USB).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 1 ms scheduler tick: the keyer reads the contacts every millisecond.
CONFIG_FREERTOS_HZ=1000
# Phones probing for a captive portal send long request headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
# A new firmware that does not start properly is replaced by the previous one at the next restart.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
